<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="relative overflow-hidden rounded-3xl bg-linear-to-br from-violet-600 via-indigo-600 to-cyan-500 shadow-2xl shadow-indigo-500/30">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(255,255,255,0.22),transparent_45%)]" />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_85%,rgba(255,255,255,0.14),transparent_40%)]" />

    <div class="relative px-6 py-16 sm:px-12 sm:py-24 text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur">
        <.icon name="hero-sparkles" class="size-3.5" /> AI-native compliance
      </span>

      <h1 class="font-display mt-6 text-4xl sm:text-6xl font-bold tracking-tight text-white text-balance">
        Compliance on autopilot
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-white/85 max-w-2xl mx-auto text-balance">
        An agent that reads every incoming vendor document, validates it against your
        rules, and only pauses for a human when a decision actually needs one.
      </p>

      <div class="mt-10">
        <.link
          href={~p"/auth/google"}
          class="btn btn-lg bg-white text-indigo-700 hover:bg-white/90 border-none shadow-xl shadow-black/20 rounded-full font-semibold"
        >
          Sign in with Google
        </.link>
      </div>
    </div>
  </div>

  <div class="relative -mt-10 grid gap-6 px-2 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="size-11 rounded-2xl bg-linear-to-br from-violet-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
          <.icon name="hero-document-magnifying-glass" class="size-6 text-white" />
        </div>
        <h2 class="card-title text-base mt-2">Automatic extraction</h2>
        <p class="text-sm opacity-70">
          Reads each submitted document — contracts, W-9s, invoices — and pulls out the
          fields your compliance rules care about, no manual data entry.
        </p>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="size-11 rounded-2xl bg-linear-to-br from-indigo-500 to-cyan-500 flex items-center justify-center shadow-lg shadow-cyan-500/30">
          <.icon name="hero-shield-check" class="size-6 text-white" />
        </div>
        <h2 class="card-title text-base mt-2">Built-in validation</h2>
        <p class="text-sm opacity-70">
          Cross-checks entity names, verifies Tax IDs, and screens vendors against sanctions
          lists before a document is ever marked approved.
        </p>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="size-11 rounded-2xl bg-linear-to-br from-cyan-500 to-pink-500 flex items-center justify-center shadow-lg shadow-pink-500/30">
          <.icon name="hero-user-circle" class="size-6 text-white" />
        </div>
        <h2 class="card-title text-base mt-2">Human in the loop</h2>
        <p class="text-sm opacity-70">
          Anything ambiguous halts for a reviewer to see the original document, the extracted
          fields, and the agent's reasoning side by side before deciding.
        </p>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="size-11 rounded-2xl bg-linear-to-br from-pink-500 to-violet-500 flex items-center justify-center shadow-lg shadow-violet-500/30">
          <.icon name="hero-clipboard-document-check" class="size-6 text-white" />
        </div>
        <h2 class="card-title text-base mt-2">Full audit trail</h2>
        <p class="text-sm opacity-70">
          Every run, decision, and reviewer action is recorded, so you can show exactly why a
          document was approved or rejected.
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
