# Copy this file to .env and fill in real values, then run any mix command
# as normal (mix eval.run, mix phx.server, ...). .env is gitignored — never
# commit real keys. Loaded by config/config.exs; a real exported shell env
# var always takes priority over a value in this file.

# Needed for the agent pipeline's real LLM calls: extraction, entity-match's
# ambiguous-case fallback, and explanation drafting (all gpt-4o-mini). Not
# needed to run the test suite — that uses injected fakes.
OPENAI_API_KEY=

# Needed only for the eval harness's LLM-judge tier (claude-sonnet-5). The
# deterministic eval tier runs without it.
ANTHROPIC_API_KEY=

# Needed for "Sign in with Google" on the dashboard. Create an OAuth client
# at https://console.cloud.google.com/apis/credentials (Application type:
# Web application) with an authorized redirect URI of
# http://localhost:4000/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
