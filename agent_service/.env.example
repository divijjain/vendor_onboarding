# Required for the real Agent 1 extractor (app/graph.py's default_extractor).
# Not needed to run the test suite — tests inject a fake extractor instead.
OPENAI_API_KEY=

# Defaults shown are correct for local dev against the Phoenix app's Postgres.
CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_onboarding_dev
PHOENIX_CALLBACK_URL=http://localhost:4000/webhooks/agent_callback
