# Required for the real agent LLM calls (extraction, entity-match, explanation
# drafting — all in app/graph.py). Not needed to run the test suite — tests
# inject fake LLM calls instead. Also required to run evals/run.py for real.
OPENAI_API_KEY=

# Required only for the DeepEval LLM-judge tier (evals/judge.py) — deliberately
# a different provider than the agents above, to avoid self-grading inflation.
# The deterministic tier of evals/run.py runs fine without this.
ANTHROPIC_API_KEY=

# Defaults shown are correct for local dev against the Phoenix app's Postgres.
CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_onboarding_dev
PHOENIX_CALLBACK_URL=http://localhost:4000/webhooks/agent_callback
